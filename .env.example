# Supabase local / cloud environment variables
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_placeholder
APP_ORIGIN=http://localhost:3000
# Browser calls should use the reverse proxy. In Docker, server-rendered pages
# use LEARNING_API_INTERNAL_URL=http://api:8000 (set by Compose).
NEXT_PUBLIC_LEARNING_API_URL=/api
